# --- core ---
PORT=3000
BASE_URL=http://localhost:3000
DATABASE_PATH=./data/app.db
ADMIN_TOKEN=replace-with-a-unique-random-secret-of-at-least-32-characters

# Publication identity (shown across the site + emails)
SITE_NAME=Digital Economics
SITE_TAGLINE=AI, Finance & Financial Literacy

# --- AI (content pipeline) ---
ANTHROPIC_API_KEY=
# Model for draft generation. Default is the latest Opus; switch to a cheaper
# model (e.g. claude-sonnet-5) for routine runs.
ANTHROPIC_MODEL=claude-opus-5
# The standing beat the weekly arc covers.
DIGEST_THEME=Digital Economics — AI, Finance & Financial Literacy

# --- schedule (weekly arc roundup) ---
SCHEDULER_ENABLED=false
# Default: Fridays at 07:00 in DIGEST_TZ (the arc closes on Friday).
DIGEST_CRON=0 7 * * 5
DIGEST_TZ=Europe/London

# --- email (console transport used if RESEND_API_KEY unset) ---
RESEND_API_KEY=
EMAIL_FROM="Digital Economics <news@example.com>"

# --- substack (optional) ---
SUBSTACK_POST_EMAIL=

# --- linkedin (optional) ---
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_AUTHOR_URN=
